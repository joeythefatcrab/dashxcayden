# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# Set to "true" to enable Google OAuth sign-in button (also requires AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# UploadThing
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"

# Resend Email Service
# Get your API key from https://resend.com/api-keys (Free: 3,000 emails/month)
# See docs/RESEND_SETUP.md for detailed setup instructions
RESEND_API_KEY="re_..."
# For development, use: onboarding@resend.dev
# For production, use your verified domain: noreply@yourdomain.com
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Inngest
INNGEST_EVENT_KEY="your-event-key"
INNGEST_SIGNING_KEY="your-signing-key"
