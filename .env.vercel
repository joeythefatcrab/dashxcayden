# ==============================================
# VERCEL ENVIRONMENT VARIABLES
# Copy these to Vercel → Settings → Environment Variables
# ==============================================

# ------------------
# REQUIRED (Minimum to deploy)
# ------------------

# Database - Get from neon.tech
# 1. Go to https://neon.tech
# 2. Create project → Copy connection string
DATABASE_URL="postgresql://user:password@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth Secret - Generate with command below or use website
# Command: openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
AUTH_SECRET="REPLACE_WITH_32_CHAR_RANDOM_STRING"

# Your Vercel app URL (update after first deploy)
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"

NODE_ENV="production"

# ------------------
# OPTIONAL (Add later for full features)
# ------------------

# Google OAuth - Get from console.cloud.google.com
# 1. Create OAuth 2.0 Client
# 2. Add redirect: https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# UploadThing - Get from uploadthing.com
# 1. Sign up → Create app
# 2. Copy secret & app ID
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Resend Email - Get from resend.com
# 1. Sign up → Create API key
# 2. Verify your domain or use sandbox
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Inngest - Get from inngest.com
# 1. Sign up → Get keys
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
