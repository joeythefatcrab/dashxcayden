// Homeschool SaaS Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User & Role Management
enum Role {
  PARENT
  STUDENT
  ADMIN
  SUPERADMIN  // CEO/platform-wide admin
}

// Multi-org support
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique  // URL-friendly identifier
  domain      String?  // Optional: for email domain-based org assignment

  // Settings
  isActive    Boolean  @default(true)
  maxUsers    Int?     // Optional user limit

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       User[]

  @@index([slug])
  @@index([domain])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For email/password auth
  role          Role      @default(PARENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Organization membership (null for superadmin)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Admin hierarchy: parents can belong to an admin
  adminId       String?
  admin         User?     @relation("AdminParents", fields: [adminId], references: [id], onDelete: SetNull)
  parents       User[]    @relation("AdminParents")

  accounts      Account[]
  sessions      Session[]
  students      Student[]
  children      Student[] @relation("StudentParent")
  curricula     Curriculum[] @relation("CurriculumCreator")
  userActivities UserActivity[]
  sentMessages  Message[] @relation("SentMessages")
  curriculumAccess ParentCurriculumAccess[]

  // Parent settings
  digestFrequency String @default("daily") // daily, weekly, none
  notifyEmail     Boolean @default(true)
  notifySms       Boolean @default(false)
  phoneNumber     String?

  // UI preferences
  theme           String @default("light") // light, dark, system

  // Stripe subscription tracking (for parents)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  @@index([email])
  @@index([adminId])
  @@index([organizationId])
  @@index([role])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

// Student Profile
model Student {
  id           String       @id @default(cuid())
  name         String
  userId       String?      // Optional: student may have own login
  parentId     String       // Link to parent user
  grade        Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Subscription status
  subscriptionActive  Boolean   @default(false)
  subscriptionEndDate DateTime?
  paywallExempt       Boolean   @default(false) // Skip paywall for pilots/testers

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent       User         @relation("StudentParent", fields: [parentId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  attempts     Attempt[]
  activities   Activity[]
  notes        Note[]
  monthlyReports MonthlyReport[]
  essaySubmissions EssaySubmission[]
  dailyQuotes  DailyQuote[]
  dailyTimeLogs DailyTimeLog[]
  dailyAttendance DailyAttendance[]

  @@index([parentId])
  @@index([subscriptionActive])
  @@index([userId])
}

// Curriculum Structure
model Curriculum {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  provider    String?
  grade       Int?
  subject     String?
  apsSubject  String?  // APS subject category for monthly reports (e.g. "Mathematics")
  isPublic    Boolean  @default(true)

  createdById String
  createdBy   User     @relation("CurriculumCreator", fields: [createdById], references: [id])

  rawFileUrl  String?  // Original uploaded file
  rawData     Json?    // Parsed JSON before mapping

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       Unit[]
  enrollments Enrollment[]
  dailyTimeLogs DailyTimeLog[]
  parentAccess ParentCurriculumAccess[]

  @@index([createdById])
}

model Unit {
  id           String     @id @default(cuid())
  curriculumId String
  title        String
  description  String?    @db.Text
  order        Int

  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  lessons      Lesson[]

  @@index([curriculumId])
  @@unique([curriculumId, order])
}

model Lesson {
  id          String   @id @default(cuid())
  unitId      String
  title       String
  description String?  @db.Text
  contentMd   String   @db.Text

  // Adaptive gating
  threshold   Int      @default(70) // Minimum score to unlock next lesson
  order       Int

  // Learning objectives/standards
  objectives  String[] // Array of learning objective codes

  attachmentUrl String? // Optional uploaded PDF (checksheet, etc.)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  items       Item[]
  attempts    Attempt[]

  @@index([unitId])
  @@unique([unitId, order])
}

// Assessment Items
enum ItemType {
  MCQ
  SHORT_ANSWER
  ESSAY
  TRUE_FALSE
  CHECKBOX  // For checklist/task items from curriculum PDFs
}

model Item {
  id         String   @id @default(cuid())
  lessonId   String
  type       ItemType
  order      Int

  prompt     String   @db.Text

  // For MCQ/True-False: JSON array of choices
  choices    Json?

  // Answer key - flexible structure based on type
  // MCQ: { "correct": [0, 2] } for indices
  // SHORT_ANSWER: { "patterns": ["exact match", "/regex/i"] }
  answerKey  Json

  points     Int      @default(1)
  isOptional Boolean  @default(false) // Optional items can be skipped/opted-out

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@unique([lessonId, order])
}

// Glossary for hover definitions
model GlossaryTerm {
  id          String   @id @default(cuid())
  term        String   @unique
  definition  String   @db.Text
  derivation  String?  @db.Text
  mediaUrl    String?  // Optional image/video URL
  mediaType   String?  // "image" | "video"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([term])
}

// Student Progress Tracking
model Enrollment {
  id           String   @id @default(cuid())
  studentId    String
  curriculumId String

  // Progress tracking per lesson
  // { "lessonId": { "unlocked": true, "score": 85, "completedAt": "ISO date" } }
  progress     Json     @default("{}")

  enrolledAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  curriculum   Curriculum  @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([studentId, curriculumId])
  @@index([studentId])
  @@index([curriculumId])
}

// Assessment Attempts
model Attempt {
  id        String   @id @default(cuid())
  studentId String
  lessonId  String

  score     Int      // Percentage 0-100
  maxScore  Int      // Total points possible
  earned    Int      // Points earned

  // Detailed responses: { "itemId": { "answer": ..., "correct": bool, "points": ... } }
  detail    Json

  timeSpent Int?     // Seconds
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([createdAt])
}

// Essay Submissions
enum EssayStatus {
  DRAFT
  SUBMITTED
  GRADED
  REVISION_REQUESTED
}

model EssaySubmission {
  id          String      @id @default(cuid())
  studentId   String
  lessonId    String
  itemId      String      // The essay question/prompt item

  // Rich text content (HTML)
  content     String      @db.Text

  // Submission tracking
  status      EssayStatus @default(DRAFT)
  submittedAt DateTime?

  // AI Grading (automatic on submission)
  aiGrade         Int?     // AI's suggested percentage 0-100
  aiStrengths     String?  @db.Text // JSON array of strengths
  aiImprovements  String?  @db.Text // JSON array of improvements
  aiSummary       String?  @db.Text // Overall AI assessment
  aiParentNote    String?  @db.Text // Note specifically for parent
  aiGradedAt      DateTime?

  // Final Grading (parent approval/override)
  grade       Int?        // Final percentage 0-100 (from AI or parent override)
  feedback    String?     @db.Text // Parent's additional feedback (optional)
  gradedAt    DateTime?
  gradedBy    String?     // Parent/Admin user ID

  // Revision Requests
  revisionNote String?    @db.Text // Parent's note when requesting revision
  revisionRequestedAt DateTime?
  revisionRequestedBy String?     // Parent/Admin user ID

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, itemId])
  @@index([studentId])
  @@index([lessonId])
  @@index([itemId])
  @@index([status])
  @@index([submittedAt])
}

// Student Notes
model Note {
  id        String   @id @default(cuid())
  studentId String
  title     String?  // Subject/title of the note
  lessonId  String?  // Optional: note on entire lesson
  itemId    String?  // Optional: note on specific item
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([lessonId])
  @@index([itemId])
  @@index([createdAt])
}

// Activity Log for parent digests
model Activity {
  id        String   @id @default(cuid())
  studentId String
  type      String   // "lesson_started", "lesson_completed", "assignment_graded"
  lessonId  String?
  metadata  Json?    // Extra context
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

// Platform-wide user activity log for superadmin
model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  userRole    String   // STUDENT, PARENT, ADMIN, SUPERADMIN for filtering
  type        String   // ESSAY_SUBMIT, LESSON_COMPLETE, GRADE_SUBMIT, REVISION_REQUEST, etc.
  description String   @db.Text
  metadata    Json?    // Additional context
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@index([userRole])
  @@index([createdAt])
}

// Digest History (track what was sent)
model DigestLog {
  id        String   @id @default(cuid())
  parentId  String
  type      String   // "daily" | "weekly"
  sentAt    DateTime @default(now())

  // Summary stats included in digest
  summary   Json

  @@index([parentId, sentAt])
}

// Student Invitations
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model StudentInvitation {
  id            String           @id @default(cuid())
  parentId      String
  studentEmail  String
  studentName   String?
  token         String           @unique
  status        InvitationStatus @default(PENDING)

  // Curricula to auto-enroll student in when they accept
  curriculaIds  String[]         @default([])

  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  acceptedAt    DateTime?

  @@index([parentId])
  @@index([studentEmail])
  @@index([token])
  @@index([status])
}

// Admin Messaging System
enum MessageRecipientType {
  STUDENT
  PARENT
  ADMIN
  ALL
}

model Message {
  id              String               @id @default(cuid())
  content         String               @db.Text
  title           String?              // Optional message title
  senderId        String
  sender          User                 @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // Targeting
  recipientType   MessageRecipientType
  recipientIds    String[]             @default([]) // Empty means all users of recipientType
  organizationId  String?              // Optional: limit to specific organization

  // Metadata
  createdAt       DateTime             @default(now())
  expiresAt       DateTime?            // Optional: auto-hide after this date

  // Relations
  readReceipts    MessageRead[]

  @@index([senderId])
  @@index([recipientType])
  @@index([organizationId])
  @@index([createdAt])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

// Monthly Reports System
model MonthlyReport {
  id              String              @id @default(cuid())
  studentId       String
  parentId        String
  month           Int                 // 1-12
  year            Int

  // AI-generated report content
  reportContent   String?             @db.Text
  generatedAt     DateTime?

  // APS Requirements
  attendanceData  Json?               @default("{}") // { "present": 20, "sick": 1, "vacation": 2 }
  parentNotes     String?             @db.Text       // Custom notes from parent
  educatorEvaluation Json?            // Answers to APS educator evaluation questions

  // Metadata
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalActivities ExternalActivity[]

  @@unique([studentId, month, year])
  @@index([studentId])
  @@index([parentId])
  @@index([month, year])
}

model ExternalActivity {
  id              String         @id @default(cuid())
  reportId        String
  title           String
  description     String?        @db.Text
  date            DateTime
  hoursSpent      Float?         // Hours spent on activity
  category        String?        // e.g., "Field Trip", "Reading", "Project"

  // Track who submitted
  submittedBy      String?   // "student" or "parent"

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  report          MonthlyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([date])
}

// Daily Attendance (auto-tracked when student logs in or logs activity)
model DailyAttendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime // The date this attendance is for
  present   Boolean  @default(true) // Present by default when created
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
}

// Parent Curriculum Access Control
model ParentCurriculumAccess {
  id           String     @id @default(cuid())
  parentId     String
  curriculumId String
  grantedAt    DateTime   @default(now())
  grantedBy    String?    // Admin who granted access

  parent       User       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([parentId, curriculumId])
  @@index([parentId])
  @@index([curriculumId])
}

// Daily Quotes (track recent quotes to avoid repetition)
model DailyQuote {
  id        String   @id @default(cuid())
  studentId String
  quote     String   @db.Text
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

// Single-use invite codes with preset roles
model InviteCode {
  id             String    @id @default(cuid())
  code           String    @unique
  role           Role
  label          String?   // Optional human-readable label, e.g. "Johnson Family"
  createdById    String
  organizationId String?   // Scoped org for admin-created codes
  usedAt         DateTime?
  usedByEmail    String?   // Who redeemed it
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([code])
  @@index([createdById])
  @@index([organizationId])
}

// System Settings (for superadmin configuration)
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "signup_code"
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// Daily Time Log (student self-reported daily time)
model DailyTimeLog {
  id           String   @id @default(cuid())
  studentId    String
  date         DateTime // The date this log is for
  curriculumId String
  minutesSpent Int      // Minutes spent on this curriculum
  description  String?  @db.Text // What they worked on

  // Track who submitted
  submittedBy      String?  // "student" or "parent"

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  curriculum   Curriculum  @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, curriculumId])
  @@index([studentId, date])
  @@index([curriculumId])
}
